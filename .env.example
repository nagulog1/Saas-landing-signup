# Copy this file to .env and fill in your values
PORT=3000
# Public address of the site, used to build links inside emails
APP_URL=http://localhost:3000

# MongoDB connection string.
# Local:  mongodb://127.0.0.1:27017/meshwatch
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/meshwatch
# Leave empty to use a temporary in-memory MongoDB (data is lost on restart).
MONGO_URI=

# Signs the dashboard login cookie. Use a long random string.
SESSION_SECRET=change_this_to_a_long_random_secret

# Password for the leads admin page at /admin.html
ADMIN_PASSWORD=admin123

# ---- Email (Nodemailer) ----
# Leave SMTP_HOST empty in development: the app creates a free Ethereal test inbox
# and shows a "preview email" link instead of sending real mail.
#
# To send real emails with Gmail:
#   1. Turn on 2-Step Verification on your Google account
#   2. Create an App Password: myaccount.google.com/apppasswords
#   3. SMTP_HOST=smtp.gmail.com  SMTP_PORT=465  SMTP_USER=you@gmail.com  SMTP_PASS=<16-char app password>
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Meshwatch <no-reply@meshwatch.dev>"
