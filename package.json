{
  "name": "meshwatch-landing",
  "version": "1.0.0",
  "description": "SaaS landing page with lead capture, form validation, email verification (Nodemailer), MongoDB storage and a thank-you dashboard",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "build:css": "tailwindcss -i ./styles/input.css -o ./public/css/styles.css --minify",
    "watch:css": "tailwindcss -i ./styles/input.css -o ./public/css/styles.css --watch"
  },
  "license": "MIT",
  "dependencies": {
    "cookie-parser": "^1.4.6",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.5.1",
    "nodemailer": "^6.9.14"
  },
  "optionalDependencies": {
    "mongodb-memory-server": "^10.0.0"
  },
  "devDependencies": {
    "tailwindcss": "^3.4.19"
  }
}
